# SoilUnitAnalysis — environment variables
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Per CLAUDE.md "Hard Rules": credentials must be read from environment
# variables; never hard-code them in scripts.

# NEON personal access token. Recommended for `neonUtilities` calls so AOP
# downloads are not subject to anonymous rate limits.
# Obtain from https://data.neonscience.org/ after creating an account.
NEON_TOKEN=

# INFILTRATION_DATA_DIR: full path to the folder containing daily entry .xlsx
# files for the soil infiltration pipeline. Set this so the pipeline finds
# the network drive without prompting. Each team member sets this locally;
# .env is gitignored and never committed.
# Windows example:  X:\moore\2026_B2_SoilProp\Data\Infiltration\Soil_Infiltration_FieldData
# UNC example:      \\snre-snow\projects\moore\2026_B2_SoilProp\Data\Infiltration\Soil_Infiltration_FieldData
# Mac example:      /Volumes/projects/moore/2026_B2_SoilProp/Data/Infiltration/Soil_Infiltration_FieldData
INFILTRATION_DATA_DIR=

# SOILMOISTURE_DATA_DIR: full path to the folder containing daily entry .xlsx
# files for the soil moisture pipeline.
# Windows example:  X:\moore\2026_B2_SoilProp\Data\SoilMoisture\B2_SoilMoisture_DataSheet_DailyData
# UNC example:      \\snre-snow\projects\moore\2026_B2_SoilProp\Data\SoilMoisture\B2_SoilMoisture_DataSheet_DailyData
# Mac example:      /Volumes/projects/moore/2026_B2_SoilProp/Data/SoilMoisture/B2_SoilMoisture_DataSheet_DailyData
SOILMOISTURE_DATA_DIR=

# ASD_DATA_DIR: full path to the ASD base data folder (parent of
# ProcessedReflectance/, SpectralID/, and FullSpectralFieldData/).
# Windows example:  X:\moore\2026_B2_SoilProp\Data\ASD
# UNC example:      \\snre-snow\projects\moore\2026_B2_SoilProp\Data\ASD
# Mac example:      /Volumes/projects/moore/2026_B2_SoilProp/Data/ASD
ASD_DATA_DIR=

# TRAILCAM_RAW_IMAGE_DIR: root folder of trail camera images on the network
# drive. Must contain one subdirectory per camera ID (0C, 2C, 3B, …).
# Windows example:  X:\moore\2026_B2_SoilProp\Data\TrailCamera
#     or UNC:       \\snre-snow\projects\moore\2026_B2_SoilProp\Data\TrailCamera
# Mac example:      /Volumes/projects/moore/2026_B2_SoilProp/Data/TrailCamera
TRAILCAM_RAW_IMAGE_DIR=
